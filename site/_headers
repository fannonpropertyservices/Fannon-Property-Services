# Netlify: the service walkthrough's frames and the hashed build files can be kept by the browser.
/assets/cinema/*
  Cache-Control: public, max-age=86400
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
# Photos, pictures, drawings and the logo keep their file names when they change, so a browser may keep them for a week, not longer.
/assets/own/*
  Cache-Control: public, max-age=604800
/assets/gen/*
  Cache-Control: public, max-age=604800
/assets/drawn/*
  Cache-Control: public, max-age=604800
/assets/brand/*
  Cache-Control: public, max-age=604800
